                                .padding(.vertical, 16)
                            }
                            .buttonStyle(.plain)
                            .background(Color.white)
                            .padding(.top, 16)
                        } else {
                            NavigationLink {
                                SignInView()
                            } label: {
                                HStack {
                                    Image(systemName: "arrow.right.square")
                                        .font(.system(size: 16))
                                        .foregroundColor(brandRed)
                                        .frame(width: 24)
                                    Text("Sign In")
                                        .font(.system(size: 13))
                                        .foregroundColor(brandRed)
                                    Spacer()
                                }
                                .padding(.horizontal, 20)
