import SwiftUI

struct ProductCard: View {
    let product: Product
    @Environment(\.colorScheme) private var colorScheme

    var body: some View {
        VStack(alignment: .leading, spacing: 6) {

            AsyncImage(url: URL(string: product.imageUrl)) { image in
                image
